[
  {"name": "transaction_id", "type": "STRING", "mode": "REQUIRED", "description": "Stable unique id for the transaction"},
  {"name": "user_id", "type": "STRING", "mode": "REQUIRED"},
  {"name": "account_id", "type": "STRING", "mode": "REQUIRED"},
  {"name": "txn_date", "type": "DATE", "mode": "REQUIRED", "description": "Date the transaction occurred (partition column)"},
  {"name": "posted_at", "type": "TIMESTAMP", "mode": "NULLABLE"},
  {"name": "raw_description", "type": "STRING", "mode": "REQUIRED", "description": "Messy bank-feed descriptor, e.g. 'SQ *BLUE BOTTLE CO 0423 OAKLAND CA'"},
  {"name": "merchant_name", "type": "STRING", "mode": "NULLABLE", "description": "Clean merchant name, filled by the Gemini categorizer"},
  {"name": "amount", "type": "NUMERIC", "mode": "REQUIRED", "description": "Positive number; see direction"},
  {"name": "direction", "type": "STRING", "mode": "REQUIRED", "description": "debit (money out) or credit (money in)"},
  {"name": "currency", "type": "STRING", "mode": "REQUIRED"},
  {"name": "channel", "type": "STRING", "mode": "NULLABLE", "description": "card, ach, transfer, atm"},
  {"name": "category", "type": "STRING", "mode": "NULLABLE", "description": "Spending category, filled by the categorizer"},
  {"name": "category_source", "type": "STRING", "mode": "NULLABLE", "description": "rule, gemini or user"},
  {"name": "category_confidence", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "source", "type": "STRING", "mode": "REQUIRED", "description": "backfill, daily_feed or receipt"},
  {"name": "ingested_at", "type": "TIMESTAMP", "mode": "REQUIRED"}
]
